rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Allow reading user list / documents
      allow read: if true;

      // Allow creating a user with required fields
      allow create: if request.resource.data.username is string
                    && request.resource.data.username.size() >= 2
                    && request.resource.data.role in ['Admin', 'Manager', 'Editor', 'Viewer']
                    && request.resource.data.status in ['active', 'disabled']
                    && request.resource.data.createdAt != null;

      // Allow updating username, role, status, updatedAt
      allow update: if request.resource.data.username is string
                    && request.resource.data.role in ['Admin', 'Manager', 'Editor', 'Viewer']
                    && request.resource.data.status in ['active', 'disabled'];

      // Deletions MUST be performed via Cloud Functions (Admin SDK)
      allow delete: if false;
    }

  }
}